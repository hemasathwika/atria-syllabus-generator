      "syllabi": {
        "BBCOAB301": {
          "title": "Computer Organization and Architecture",
          "semester": "III",
          "code": "BBCOAB301",
          "type": "IPCC",
          "cia": 50,
          "see": 50,
          "slt": "42:0:28:56",
          "l": 42,
          "t": 0,
          "p": 28,
          "s": 56,
          "total_marks": 100,
          "credits": 4,
          "exam_hours": "03",
          "exam_type": "Theory",
          "outcomes": [
            {
              "id": "CO1",
              "desc": "Apply four-variable K-map techniques and don’t-care conditions to simplify combinational logic circuits and develop Verilog models for simple digital circuits.",
              "cl": "3",
              "pl": "3"
            },
            {
              "id": "CO2",
              "desc": "Describe the fundamentals of machine instructions, addressing modes and Processor performance.",
              "cl": "3",
              "pl": "2"
            },
            {
              "id": "CO3",
              "desc": "Describe basic processor operations and analyze pipelining and its performance.",
              "cl": "3",
              "pl": "3"
            },
            {
              "id": "CO4",
              "desc": "Explain RTL, register transfer operations, bus transfer mechanisms, and logic micro-operations with their hardware implementation in digital systems.",
              "cl": "3",
              "pl": "3"
            },
            {
              "id": "CO5",
              "desc": "Compare various parallel computer structures based on architecture, performance, and application requirements.",
              "cl": "3",
              "pl": "3"
            }
          ],
          "co_assessment": [
            {
              "co": "CO 1",
              "cie1": "M1",
              "cie2": "",
              "assignment": "M1",
              "see": "M1"
            },
            {
              "co": "CO 2",
              "cie1": "M2",
              "cie2": "",
              "assignment": "M2",
              "see": "M2"
            },
            {
              "co": "CO 3",
              "cie1": "M3",
              "cie2": "M3",
              "assignment": "M3",
              "see": "M3"
            },
            {
              "co": "CO 4",
              "cie1": "",
              "cie2": "M4",
              "assignment": "M4",
              "see": "M4"
            },
            {
              "co": "CO 5",
              "cie1": "",
              "cie2": "M5",
              "assignment": "M5",
              "see": "M5"
            }
          ],
          "modules": [
            {
              "num": "Module 1",
              "co": "CO 1",
              "level": "CL: 3 / PL: 3",
              "content": "The Map Method: K map Four-Variable Map, Don’t-Care Conditions, NAND and NOR Implementation, Other Hardware Description Language – Verilog Model of a simple circuit.\nCombinational Logic: Introduction, Combinational Circuits, Half adder, Full adder, Half Subtractor, Full Subtractor, Decoders, Encoders, Multiplexers. Sequential Logic: Introduction, Sequential Circuits, Storage Elements: Latches, Flip-Flops.",
              "textbook_ref": "Text book 1: 3.1, 3.2, 3.3, 3.5, 3.6, 3.9, 4.1, 4.2, 4.5, 4.9, 4.10, 4.11, 5.1, 5.2, 5.3, 5.4."
            },
            {
              "num": "Module 2",
              "co": "CO 2",
              "level": "CL: 3 / PL: 2",
              "content": "Basic Structure of Computers: Functional Units, Basic Operational Concepts, Bus structure, Instruction Set Architecture: Representation of Instructions, Machine instructions, Operands, addressing modes.\nMachine Instructions and Programs: Memory Location and Addresses, Memory Operations, Instruction and Instruction sequencing, Addressing Modes.",
              "textbook_ref": "Text book 2: 1.2, 1.3, 1.4, 1.6, 2.2, 2.3, 2.4.1, 2.4.2, 2.4.3, 2.5."
            },
            {
              "num": "Module 3",
              "co": "CO 3",
              "level": "CL: 3 / PL: 3",
              "content": "Input/output Organization: Direct Memory Access: Bus Arbitration, Basic Processing Unit: Some Fundamental Concepts: Register Transfers, Performing ALU operations, fetching a word from Memory, Storing a word in Memory, Execution of complete instruction.",
              "textbook_ref": "Text book 2: 4.4, 7.1.1, 7.1.2, 7.1.3, 7.1.4, 7.2."
            },
            {
              "num": "Module 4",
              "co": "CO 4",
              "level": "CL: 3 / PL: 3",
              "content": "Pipelining: Basic concepts, Role of Cache memory, Pipeline Performance, Pipeline hazards.\nRegister Transfer and Micro-operations: Register Transfer Language (RTL), Register transfer, Bus & memory transfer-Three state bus buffer, Logic micro-operations-Hardware implementation, Application, Shift micro-operation-Hardware implementation.",
              "textbook_ref": "Text book 3: 4.1, 4.2, 4.3, 4.5, 4.6, 8.1, 8.2."
            },
            {
              "num": "Module 5",
              "co": "CO 5",
              "level": "CL: 3 / PL: 3",
              "content": "Introduction To Parallel Processing: Parallelism in uniprocessor system, Parallel Computer Structures- Pipeline Computers, Array computers, Multiprocessor System, Performance of Parallel Computers, Parallel processing applications.",
              "textbook_ref": "Text book 4: 1.2.1, 1.2.2, 1.3.1, 1.3.2, 1.3.3, 1.3.4, 1.5."
            }
          ],
          "practicals": {
            "has_practical": true,
            "part_a": [
              "Given a 4-variable logic expression, simplify it using appropriate technique and design and implement the same using basic gates.",
              "Design and implement Half adder, Full Adder, Half Subtractor, Full Subtractor using basic gates. And implement the same in HDL.",
              "Design Verilog program for implementing various types of Flip-Flops such as SR, JK and D.",
              "Design and simulate a 4-bit Arithmetic Logic Unit (ALU) capable of performing arithmetic and logical operations using Verilog HDL.",
              "Design and implement an Encoder and Decoder circuit using Verilog HDL and verify the output responses.",
              "Develop a simple memory module (RAM/ROM) using Verilog HDL and verify read/write operations through simulation.",
              "Implement a Verilog module to simulate a Register Transfer system that executes logic and shift micro-operations on an 8-bit common data bus using three-state buffers.",
              "Design and simulate a Parallel Arithmetic Unit in Verilog to demonstrate concurrent hardware execution by computing the sum, difference, product, and bitwise XOR of two 4-bit numbers simultaneously within a single clock cycle."
            ],
            "part_b": [
              "Case Studies: RISC vs CISC Architectures in Modern Processors.",
              "GPU Architecture for High-Performance Computing.",
              "ARM Processor Architecture in Mobile Devices."
            ]
          },
          "textbooks": [
            "M. Morris Mano & Michael D. Ciletti, Digital Design With an Introduction to Verilog Design, 6e, Pearson Education, 2018.",
            "Carl Hamacher, Zvonko Vranesic, Safwat Zaky, Computer Organization, 5th Edition, Tata McGraw Hill.",
            "M. Morris Mano, Computer System Architecture, 3rd Edition, PHI Pvt ltd.",
            "Computer Architecture and parallel processing, Kai Hwang, Faye A. Briggs, Tata McGraw Hill."
          ],
          "references": [
            "Digital Design and Computer Architecture by David Money Harris and Sarah L. Harris.",
            "Computer Organization and Design: The Hardware/Software Interface by David A. Patterson and John L. Hennessy."
          ],
          "web_links": [
            "https://cse11-iiith.vlabs.ac.in/"
          ]
        },
        "BBDSAB302": {
          "title": "Data Structures and Applications",
          "semester": "III",
          "code": "BBDSAB302",
          "type": "IPCC",
          "cia": 50,
          "see": 50,
          "slt": "42:0:28:56",
          "l": 42,
          "t": 0,
          "p": 28,
          "s": 56,
          "total_marks": 100,
          "credits": 4,
          "exam_hours": "03",
          "exam_type": "Theory / Laboratory",
          "outcomes": [
            {
              "id": "CO1",
              "desc": "Explain different data structures and their applications.",
              "cl": "2",
              "pl": "–"
            },
            {
              "id": "CO2",
              "desc": "Apply Stacks and Queue data structures to solve the given problem.",
              "cl": "3",
              "pl": "3"
            },
            {
              "id": "CO3",
              "desc": "Use the concept of linked list in problem solving.",
              "cl": "3",
              "pl": "3"
            },
            {
              "id": "CO4",
              "desc": "Demonstrate the operations on binary tree and BST.",
              "cl": "3",
              "pl": "3"
            },
            {
              "id": "CO5",
              "desc": "Develop solutions using graphs, and hashing techniques to solve real-world problems.",
              "cl": "3",
              "pl": "3"
            }
          ],
          "co_assessment": [
            {
              "co": "CO 1",
              "cie1": "M1",
              "cie2": "",
              "assignment": "M1",
              "see": "M1"
            },
            {
              "co": "CO 2",
              "cie1": "M2",
              "cie2": "",
              "assignment": "M2",
              "see": "M2"
            },
            {
              "co": "CO 3",
              "cie1": "M3",
              "cie2": "M3",
              "assignment": "M3",
              "see": "M3"
            },
            {
              "co": "CO 4",
              "cie1": "",
              "cie2": "M4",
              "assignment": "M4",
              "see": "M4"
            },
            {
              "co": "CO 5",
              "cie1": "",
              "cie2": "M5",
              "assignment": "M5",
              "see": "M5"
            }
          ],
          "modules": [
            {
              "num": "Module 1",
              "co": "CO 1",
              "level": "CL: 2 / PL: –",
              "content": "Introduction to Data Structures: Primitive and Non-Primitive Data Types, Arrays, Dynamic Memory Allocation in C.\nLinear Lists: Operations on Arrays, Sparse Matrices and representations.",
              "textbook_ref": "Text Book 1: Chapter 1 & 2."
            },
            {
              "num": "Module 2",
              "co": "CO 2",
              "level": "CL: 3 / PL: 3",
              "content": "Stacks: Definition, Array representation, Operations on Stack, Applications of Stack: Infix to Postfix conversion, Evaluation of Postfix Expression.\nQueues: Definition, Array representation, Queue Operations, Circular Queue, Priority Queue, Double Ended Queue (Deque).",
              "textbook_ref": "Text Book 1: Chapter 3."
            },
            {
              "num": "Module 3",
              "co": "CO 3",
              "level": "CL: 3 / PL: 3",
              "content": "Linked Lists: Definition, Representation of Linked list in memory, Types of Linked List: Singly Linked List, Doubly Linked List, Circular Linked List.\nOperations on Linked List: Insertion, Deletion, Searching, Applications of Linked Lists: Polynomial representation and addition.",
              "textbook_ref": "Text Book 1: Chapter 4."
            },
            {
              "num": "Module 4",
              "co": "CO 4",
              "level": "CL: 3 / PL: 3",
              "content": "Trees – Introduction, Binary Trees - Properties of Binary trees, Representation of Binary Trees, Binary Tree Traversals, Threaded binary trees.\nBinary Search Trees – Introduction, Searching, Insertion, Deletion, Height of BST, Selection Trees.",
              "textbook_ref": "Text Book 1: Chapter 5 (5.1, 5.2, 5.3, 5.5, 5.7, 5.8)."
            },
            {
              "num": "Module 5",
              "co": "CO 5",
              "level": "CL: 2 / PL: 3",
              "content": "Graphs: Introduction, Definition, Graph Representation, Elementary Graph Operations: Breadth First Search, Depth First Search, Spanning Tree.\nHashing: Introduction, Hash Tables, Hash Functions, Different hash functions, collision resolution.",
              "textbook_ref": "Text Book 1: Chapter 6 (6.1, 6.2); Text Book 2: Chapter 15 (15.1-15.5)."
            }
          ],
          "practicals": {
            "has_practical": true,
            "part_a": [
              "Develop a Program in C to represent a calendar as an array of 7 elements with day, date, activity description with dynamic allocation.",
              "Write a program in C to simulate the working of stack using an array with push, pop, display, overflow and underflow.",
              "Develop a menu driven Program in C for Queue operations: Insert, Delete, Overflow, Underflow, Display.",
              "Develop a menu driven Program in C for Singly Linked List (SLL) of Student Data (USN, Name, Programme, Sem, PhNo).",
              "Develop a menu driven Program in C for Binary Search Tree (BST) operations: Create, Inorder/Preorder/Postorder traversals, Search key.",
              "Develop a Program in C for Graph operations on Cities: Adjacency Matrix and DFS/BFS reachability.",
              "Write a program to count leaf nodes, non-leaf nodes, and total nodes in a binary tree."
            ],
            "part_b": [
              "Convert a given valid parenthesized infix arithmetic expression to postfix expression in C.",
              "Develop a program in C for Postfix expression evaluation with multi-digit operands and operators.",
